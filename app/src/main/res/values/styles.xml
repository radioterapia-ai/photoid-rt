<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Label de campo: fonte clara, levemente em destaque -->
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Campo de entrada base -->
    <style name="InputField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@color/bg_input</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <!-- Botão primário (azul preenchido) -->
    <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="backgroundTint">@color/brand_primary_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">68dp</item>
    </style>

    <!-- Botão secundário (transparente com borda) -->
    <style name="ButtonSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/brand_accent</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">68dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Cabeçalho de seção dentro de telas/grupos (ex: "Via QR Code") -->
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- Descrição de seção (texto secundário menor sob o header) -->
    <style name="SectionDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Separador horizontal (linha divisória) -->
    <style name="Separator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Separador fino (mais discreto) -->
    <style name="SeparadorFino">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <!-- Outline ciano nativo do MaterialButton: cantos arredondados garantidos
         em qualquer estado (android:background custom conflita com o Material
         e cortava os cantos). -->
    <style name="ButtonOutlineCyan" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">#4FC3F7</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Popup de ações: seção, item (alvo 48dp) e divisor. -->
    <style name="PopupSecao">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- paddingLeft/Right em vez de paddingHorizontal: este ultimo so
             existe a partir da API 26 e o app declara minSdk 24. -->
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#8896AC</item>
        <item name="android:letterSpacing">0.13</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="PopupItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <!-- paddingLeft/Right em vez de paddingHorizontal: este ultimo so
             existe a partir da API 26 e o app declara minSdk 24. -->
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="PopupDivisor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">#1E2D52</item>
    </style>
</resources>
