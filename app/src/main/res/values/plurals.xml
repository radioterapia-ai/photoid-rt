<?xml version="1.0" encoding="utf-8"?>
<!--
    A categoria "many" existe desde o CLDR 38 em pt, es, fr e it, e cobre os
    multiplos exatos de um milhao. A diferenca e a preposicao: "um milhao DE
    pacientes". Sem ela o Android cai em "other" e imprime "1.000.000
    pacientes", que esta errado — ainda que nenhum servico va chegar la.
-->
<resources>
    <plurals name="patient_count_plural">
        <item quantity="one">1 paciente registrado</item>
        <item quantity="many">%d de pacientes registrados</item>
        <item quantity="other">%d pacientes registrados</item>
    </plurals>
    <plurals name="treatment_count_plural">
        <item quantity="one">1 paciente em tratamento</item>
        <item quantity="many">%d de pacientes em tratamento</item>
        <item quantity="other">%d pacientes em tratamento</item>
    </plurals>
    <plurals name="simulations_count_plural">
        <item quantity="one">1 simulação</item>
        <item quantity="many">%d de simulações</item>
        <item quantity="other">%d simulações</item>
    </plurals>
</resources>
