<?xml version="1.0" encoding="utf-8"?>
<!--
    IDs usados como CHAVE, nao como id de View declarado em layout.

    View.setTag(int, Object) exige um id de recurso: passar um inteiro qualquer
    lanca IllegalArgumentException, e so na hora em que a tag e gravada.
    Declarar aqui torna a chave unica no pacote inteiro.
-->
<resources>
    <!-- Contentor que a BaseActivity injeta sob a toolbar comum. -->
    <item name="baseContentContainer" type="id" />

    <!-- Onde o desaparecimento pendente do aviso da camera fica guardado. -->
    <item name="tag_aviso_saida" type="id" />
</resources>
