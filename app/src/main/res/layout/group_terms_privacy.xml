<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/consent_intro"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOpenTerms"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/open_terms"
        android:textColor="@color/text_on_dark"
        android:backgroundTint="@color/brand_primary_dark" />

    <Button
        android:id="@+id/btnOpenPrivacy"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="@string/open_privacy"
        android:textColor="@color/text_on_dark"
        android:backgroundTint="@color/brand_primary_dark" />
</LinearLayout>
