<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela de Finalização / Pós-processamento (item 8).

    Comportamento:
    - Após o usuário clicar "Finalizar simulação" na câmera, a sessão é ENCERRADA
      automaticamente (sessionManager.limparSessao() na MainActivity) - assim a Home
      não mostra mais rascunho em andamento ao voltar.
    - Esta tela mostra o resultado e oferece 4 ações OPCIONAIS:
        1. Visualizar PDF  (abre o PDF no app padrão do sistema)
        2. Enviar para impressora (só habilita se impressora configurada)
        3. Editar cadastro (abre EditarPacienteActivity)
        4. Adicionar mais fotos (volta pra MainActivity)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtFinTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fin_confirm_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="20dp" />

        <!--
            LINHAS DE ESTADO da simulação finalizada: sincronia e impressora.

            ACIMA do cartão de resumo, de propósito. O cartão cresce com o que
            foi preenchido, e embaixo dele as duas linhas ficariam abaixo da
            dobra em paisagem — justamente as que dizem se o envio deu certo e
            se a impressora responde. Aqui elas ficam na primeira tela nas duas
            orientações.

            O bloco só aparece na fase de resultado; o código o mostra e o
            esconde junto com as fases (mostrarFaseResultado / entrarModoEdicao).
            Cada linha cuida da própria visibilidade dentro dele.
        -->
        <LinearLayout
            android:id="@+id/layoutStatusFin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <!-- Sincronia: oculta quando a sincronização está desligada, sem
                 destino ou com «enviar ao finalizar» desligado. Os 6dp abaixo
                 juntam as duas linhas num bloco só; com ela oculta, a margem
                 some junto. -->
            <TextView
                android:id="@+id/txtSyncInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:minHeight="@dimen/fin_status_altura_min"
                android:gravity="center_vertical|start"
                android:padding="10dp"
                android:textSize="@dimen/fin_status_texto"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_card_warning"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtImprInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/fin_status_altura_min"
                android:gravity="center_vertical|start"
                android:padding="10dp"
                android:textSize="@dimen/fin_status_texto"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_card_warning"
                android:visibility="gone" />
        </LinearLayout>

        <!--
            CARTÃO DE RESUMO. Grupo do app (bg_settings_group: cartão, traço de
            1dp, raio 8dp). A hierarquia vem dos spans montados no código:
            rótulo em cor secundária, valor em branco, contagem em azul de marca
            e zero esmaecido. Os alertas ativos entram abaixo do texto como
            pílulas, na forma que espelha a ficha de Time-Out.
        -->
        <LinearLayout
            android:id="@+id/cardResumo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_settings_group">

            <TextView
                android:id="@+id/txtResumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/fin_resumo_texto"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:id="@+id/boxFinAlertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ===== TIME-OUT (rotina da clínica): sítio opcional + risco/precaução.
             Visível somente se o PDF inclui a página (Configurações/Onboarding).

             Os quatro campos de seleção falam a mesma língua: campo escuro
             (bg_seletor), altura e texto de dimens, contorno quando em foco. A
             seta é posta pelo código, no lado final do campo. -->
        <LinearLayout
            android:id="@+id/layoutTimeOutCampos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView style="@style/FieldLabel"
                android:layout_marginTop="12dp"
                android:text="@string/team_medico_label" />

            <AutoCompleteTextView
                android:id="@+id/actTimeoutMedico"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fin_campo_altura"
                android:hint="@string/timeout_medico_hint"
                android:textSize="@dimen/fin_campo_texto"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:background="@drawable/bg_seletor"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:popupBackground="@drawable/bg_popup_seletor"
                android:dropDownVerticalOffset="4dp"
                android:inputType="textCapWords"
                android:completionThreshold="1" />

            <TextView style="@style/FieldLabel"
                android:layout_marginTop="12dp"
                android:text="@string/timeout_equip_label" />

            <AutoCompleteTextView
                android:id="@+id/actTimeoutEquip"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fin_campo_altura"
                android:hint="@string/timeout_equip_hint"
                android:textSize="@dimen/fin_campo_texto"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:background="@drawable/bg_seletor"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:popupBackground="@drawable/bg_popup_seletor"
                android:dropDownVerticalOffset="4dp"
                android:focusable="false"
                android:clickable="true"
                android:completionThreshold="1" />

            <TextView style="@style/FieldLabel"
                android:layout_marginTop="12dp"
                android:text="@string/sitio_topografia_label" />

            <AutoCompleteTextView
                android:id="@+id/actTimeoutSitio"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fin_campo_altura"
                android:hint="@string/sitio_topografia_hint"
                android:textSize="@dimen/fin_campo_texto"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:background="@drawable/bg_seletor"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:popupBackground="@drawable/bg_popup_seletor"
                android:dropDownVerticalOffset="4dp"
                android:inputType="textCapCharacters"
                android:completionThreshold="1" />

            <!--
                Número máximo de visitas (opcional), logo depois do sítio.

                É informação de PLANEJAMENTO, como o sítio, e fica no grupo
                dele, antes dos alertas. Mora dentro do bloco do Time-Out porque
                o valor só chega à ficha pela página de Time-Out: com a página
                desligada, o campo some junto, em vez de oferecer um dado que
                não iria a lugar nenhum.
            -->
            <LinearLayout
                android:id="@+id/layoutFracoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/FieldLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/fin_fracoes_label" />

                <Spinner
                    android:id="@+id/spFracoes"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fin_campo_altura"
                    android:background="@drawable/bg_seletor_spinner"
                    android:popupBackground="@drawable/bg_popup_seletor"
                    android:spinnerMode="dropdown"
                    android:dropDownVerticalOffset="4dp" />
            </LinearLayout>

            <!--
                OS TRES ALERTAS, com a cor que eles produzem no cabecalho do PDF.

                A linha inteira ganha o fundo do alerta quando ligada — amarelo
                para risco de queda, laranja para precaucao de contato, vermelho
                para alergia. Sao as MESMAS cores que o PdfBuilder usa nas tarjas
                (0xFFFFE082, 0xFFFFB74D, 0xFFEF5350), e essa correspondencia e o
                ponto: quem liga o interruptor ve na hora a tarja que vai sair
                impressa, em vez de descobrir depois.
            -->
            <LinearLayout
                android:id="@+id/linhaRisco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/timeout_risco"
                    android:textColor="@color/text_primary" android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swRisco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linhaPrec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/timeout_prec"
                    android:textColor="@color/text_primary" android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swPrec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linhaAlergia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/timeout_alergia"
                    android:textColor="@color/text_primary" android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAlergia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />
            </LinearLayout>
        </LinearLayout>

        <!--
            Protocolo desta simulação.

            Depois dos alertas e antes da caixa de observação: é a escolha que
            muda o que sai impresso no fim da ficha. O bloco inteiro só aparece
            quando há mais de um protocolo — com um só não há escolha a fazer,
            e a faixa seria ruído.
        -->
        <LinearLayout
            android:id="@+id/layoutProtocolos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prot_escolher_titulo"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prot_escolher_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/faixaProtocolos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Observações da simulação (vira box na ficha do PDF se preenchido).
             Campo escuro como os de seleção acima; até 4 linhas digitadas
             (o limite e o vigia estão no código, em CampoObservacao). -->
        <LinearLayout
            android:id="@+id/layoutObservacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minHeight="56dp"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="@string/fin_observation_label"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="#33888888" />

            <EditText
                android:id="@+id/edtObservacao"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:gravity="center"
                android:padding="10dp"
                android:hint="@string/fin_observation_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:background="@drawable/bg_seletor" />
        </LinearLayout>

        <!-- ===== FASE 1 (pré-finalização): Voltar à câmera | Finalizar simulação ===== -->
        <LinearLayout
            android:id="@+id/layoutAcoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
                android:text="@string/back_to_camera"
                android:textSize="15sp"
                android:textColor="@color/text_on_dark"
                android:backgroundTint="@color/action_neutral"
                android:maxLines="2"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="15sp"
                app:autoSizeStepGranularity="1sp" />

            <Button
                android:id="@+id/btnConfirmar"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
                android:text="@string/finish_simulation"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_on_dark"
                android:backgroundTint="@color/action_save"
                android:maxLines="2"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="15sp"
                app:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <!-- ===== FASE 1-b (Editar dados, pós-finalização): salvar + atalhos ===== -->
        <LinearLayout
            android:id="@+id/layoutEdicao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnAtualizarObs"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:text="@string/fin_save_changes"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_on_dark"
                android:backgroundTint="@color/action_save"
                android:maxLines="2"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="1sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    style="@style/ButtonOutlineCyan"
                    android:id="@+id/btnAddFotos"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:text="@string/add_more_photos"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="2"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeStepGranularity="1sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtProgresso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:background="@color/status_info"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            android:text="@string/loading" />

        <!-- ===== FASE 2: dados prontos (não editáveis) ===== -->
        <LinearLayout
            android:id="@+id/layoutResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="4dp"
                android:background="@color/status_ok" />

            <!-- Linha 1: Visualizar PDF | Imprimir -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <Button
                    style="@style/ButtonOutlineCyan"
                    android:id="@+id/btnVerPdf"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="@string/view_pdf"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="2"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="13sp"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeStepGranularity="1sp" />

                <Button
                    style="@style/ButtonOutlineCyan"
                    android:id="@+id/btnImprimir"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="@string/print_only"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="2"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="13sp"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeStepGranularity="1sp" />
            </LinearLayout>

            <!-- Linha 2: Compartilhar | Editar dados -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    style="@style/ButtonOutlineCyan"
                    android:id="@+id/btnCompartilharPdf"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:drawableStart="@drawable/ic_share"
                    android:drawablePadding="6dp"
                    android:text="@string/share_pdf_btn"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="2"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeStepGranularity="1sp" />

                <Button
                    style="@style/ButtonOutlineCyan"
                    android:id="@+id/btnEditarDados"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:text="@string/fin_edit_data"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="2"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeStepGranularity="1sp" />
            </LinearLayout>

            <!-- Voltar ao Menu -->
            <Button
                android:id="@+id/btnEncerrar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="center"
                android:text="@string/finish_save_home"
                android:textSize="16sp"
                android:textColor="@color/text_on_dark"
                android:backgroundTint="@color/action_save"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="11sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="1sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
