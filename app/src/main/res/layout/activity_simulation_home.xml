<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela "Simulação". Responsiva via ScrollView + @dimen.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/landing_padding">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.4" />

        <com.radioterapia.ai.ui.PhotoIdHeaderView
            android:id="@+id/headerSim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/brand_title_sub"
            android:text="RT Sim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/simulation_desc"
            android:textSize="@dimen/landing_subtitle"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="@dimen/landing_subtitle_margin" />

        <!-- Card de rascunho pendente (oculto até detectar rascunho) -->
        <LinearLayout
            android:id="@+id/cardDraft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card_warning"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/draft_in_progress"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/txtDraftInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnContinueDraft"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/continue_draft"
                    android:textColor="@color/text_on_dark"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:backgroundTint="@color/action_save"
            android:maxLines="2"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="1sp" />

                <Button
                    android:id="@+id/btnDiscardDraft"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/discard_draft"
                    android:textColor="@color/text_on_dark"
                    android:textSize="15sp"
                    android:backgroundTint="@color/action_discard"
            android:maxLines="2"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="1sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnStartPatient"
            android:layout_width="match_parent"
            android:layout_height="@dimen/module_btn_height"
            android:text="@string/start_new_patient"
            android:textSize="@dimen/module_btn_text"
            android:textStyle="bold"
            android:textColor="@color/text_on_dark"
            android:background="@drawable/btn_module_3d"
            android:maxLines="2" />

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="@dimen/secondary_btn_height"
            android:layout_marginTop="12dp"
            android:text="@string/patient_history"
            android:textSize="17sp"
            android:textColor="@color/brand_primary"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtWifiStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:padding="8dp" />
    </LinearLayout>
</ScrollView>
