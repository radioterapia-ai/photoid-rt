<?xml version="1.0" encoding="utf-8"?>
<!--
    Adicionar foto no TRATAMENTO — padrão unificado com a câmera do RT Sim:
    pill flash/som no canto sup. direito, moldura 16:9 embutida com regra dos
    terços + pinça + ícone ⟳ girar, barra de categorias (Rosto/Etiqueta
    desabilitadas no tratamento) e ETAPA ÚNICA: "Adicionar ao carrossel".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <TextView
        android:id="@+id/txtApInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1565C0"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/apViewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Moldura do recorte: mesma regra da tela de simulacao. -->
        <com.radioterapia.ai.camera.MolduraRecorteView
            android:id="@+id/apMolduraRecorte"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/apImgPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:background="#000000"
            android:visibility="gone"
            android:contentDescription="Prévia" />

        <com.radioterapia.ai.crop.CropImageView
            android:id="@+id/apCropPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.radioterapia.ai.ui.GridOverlay
            android:id="@+id/apGridOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            layout="@layout/aviso_encaixar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="22dp" />

        <!-- Zoom vertical sobreposto à esquerda do visor (padrão RT Sim) -->
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:background="#33000000">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zoom"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false">

                <SeekBar
                    android:id="@+id/apSeekZoom"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:rotation="270"
                    android:max="100" />
            </FrameLayout>
        </LinearLayout>

        <!-- FLASH + SOM flutuantes compactos (canto superior direito) -->
        <LinearLayout
            android:id="@+id/layoutApControles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="6dp"
            android:background="@drawable/bg_step_pill">

            <ImageButton
                android:id="@+id/apBtnSwitchCam"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_switch_camera"
                android:background="@android:color/transparent"
                android:contentDescription="@string/switch_cam_label" />


            <TextView
                android:id="@+id/apTxtSwitchCamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/switch_cam_label"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />


            <ImageButton
                android:id="@+id/apBtnFlash"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_flash_off"
                android:background="@android:color/transparent"
                android:contentDescription="@string/flash_label" />

            <TextView
                android:id="@+id/apTxtFlashLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flash_label"
                android:textSize="10sp"
                android:textColor="#FFFFFF" />

            <ImageButton
                android:id="@+id/apBtnMute"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_sound_on"
                android:background="@android:color/transparent"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/mute_label" />

            <TextView
                android:id="@+id/apTxtMuteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mute_label"
                android:textSize="10sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Ícone GIRAR (pós-captura): canto superior direito do visor -->
        <ImageButton
            android:id="@+id/apBtnGirarVisor"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="@drawable/bg_icon_visor"
            android:scaleType="centerInside"
            android:contentDescription="@string/rotate_action"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtApProgresso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:background="#1565C0"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Barra de categorias (padrão RT Sim) + botão vermelho de captura à direita.
         Rosto/Etiqueta ficam apagadas no tratamento. minHeight garante o círculo
         de captura INTEIRO (78dp) sem corte em cima/embaixo. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Coluna esquerda: categorias e, no lugar delas, os botões de
             confirmação da foto / do rolo — sempre AO LADO do disparador,
             como na câmera de simulação. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tabsCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include layout="@layout/category_tab" android:id="@+id/tabFace" />
                <include layout="@layout/category_tab" android:id="@+id/tabLabel" />
                <include layout="@layout/category_tab" android:id="@+id/tabPositioning" />
                <include layout="@layout/category_tab" android:id="@+id/tabAccessories" />
                <include layout="@layout/category_tab" android:id="@+id/tabDocs" />
            </LinearLayout>

            <!-- Etapa única pós-captura: descarta ou ADICIONA AO CARROSSEL -->
            <LinearLayout
                android:id="@+id/layoutApPosFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingTop="4dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnApDescartar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="54dp"
                    android:text="@string/discard"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:textColor="@color/text_on_dark"
                    android:backgroundTint="#C62828" />

                <Button
                    android:id="@+id/btnApSalvarEnviar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="54dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/ap_add_carousel"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:textColor="@color/text_on_dark"
                    android:backgroundTint="#2E7D32" />
            </LinearLayout>

            <!-- FOTOS JA GRAVADAS nesta simulacao. Ficam ACIMA da barra do
                 rolo de propósito: primeiro o que ja existe, depois o que
                 esta sendo acrescentado agora. Toque numa delas para excluir. -->
            <LinearLayout
                android:id="@+id/layoutApExistentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtApExistentesTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/photo_existing_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/faixaApExistentes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutApRolo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="5dp">

                <Button
                    android:id="@+id/btnApGaleria"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginEnd="4dp"
                    android:text="@string/add_from_gallery"
                    android:maxLines="2"
                    android:textSize="13sp"
                    android:textColor="@color/text_on_dark"
                    android:backgroundTint="@color/action_neutral" />

                <Button
                    android:id="@+id/btnApDescartarRolo"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginEnd="4dp"
                    android:text="@string/ap_discard_roll"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:textColor="@color/text_on_dark"
                    android:backgroundTint="#C62828" />

                <Button
                    android:id="@+id/btnApSalvarRolo"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/ap_save_roll_zero"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:textColor="@color/text_on_dark"
                    android:backgroundTint="#2E7D32" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">

            <ImageButton
                android:id="@+id/btnApCapturar"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:background="@drawable/btn_capture_round"
                android:scaleType="centerInside"
                android:contentDescription="@string/capture_photo" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
