<?xml version="1.0" encoding="utf-8"?>
<!-- Filtrar/Ordenar em um só lugar: cabe em tela pequena e reúne o que antes
     era só "Ordenar". O filtro por data existe para o caso de uso do lote —
     selecionar todos os pacientes de um dia e mandar imprimir de uma vez. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <TextView
            style="@style/PopupSecao"
            android:paddingHorizontal="0dp"
            android:text="@string/filtro_ordenar_por" />

        <RadioGroup
            android:id="@+id/rgFiltroCampo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFiltroNome"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="@string/filtro_campo_nome"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbFiltroData"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:checked="true"
                android:text="@string/filtro_campo_data"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbFiltroProntuario"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="@string/filtro_campo_prontuario"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="#1E2D52" />

        <TextView
            style="@style/PopupSecao"
            android:paddingHorizontal="0dp"
            android:text="@string/filtro_ordem" />

        <RadioGroup
            android:id="@+id/rgFiltroDirecao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFiltroDesc"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:checked="true"
                android:text="@string/filtro_desc"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbFiltroAsc"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="@string/filtro_asc"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="#1E2D52" />

        <TextView
            style="@style/PopupSecao"
            android:paddingHorizontal="0dp"
            android:text="@string/filtro_periodo" />

        <TextView
            android:id="@+id/txtFiltroDataAtual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="15sp"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFiltroEscolherData"
                style="@style/ButtonOutlineCyan"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="@string/filtro_escolher_data"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnFiltroLimparData"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/filtro_todas_datas"
                android:textSize="13sp"
                android:textColor="@color/text_on_dark"
                android:backgroundTint="@color/action_neutral" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
