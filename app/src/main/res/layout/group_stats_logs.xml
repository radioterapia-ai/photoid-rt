<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stats_logs_explain"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAbrirStats"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="13sp"
            android:layout_marginEnd="4dp"
            android:text="@string/group_stats"
            android:textColor="@color/text_on_dark"
            android:backgroundTint="@color/brand_primary_dark" />

        <Button
            android:id="@+id/btnAbrirLogs"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="13sp"
            android:layout_marginStart="4dp"
            android:text="@string/group_audit_log"
            android:textColor="@color/text_on_dark"
            android:backgroundTint="@color/action_neutral" />
    </LinearLayout>
</LinearLayout>
