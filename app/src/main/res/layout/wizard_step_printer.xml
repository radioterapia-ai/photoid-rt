<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/group_printer"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/brand_primary"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wiz_printer_desc"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp" />

    <TextView style="@style/FieldLabel" android:text="@string/printer_ip" />
    <EditText android:id="@+id/edtWizPrinterIp"
        style="@style/InputField"
        android:hint="192.0.2.50"
        android:inputType="number"
        android:digits="0123456789." />

    <TextView style="@style/FieldLabel" android:text="@string/printer_name" />
    <EditText android:id="@+id/edtWizPrinterName"
        style="@style/InputField"
        android:hint="@string/printer_name_hint" />

    <TextView style="@style/FieldLabel"
        android:layout_marginTop="12dp"
        android:text="@string/printer_duplex_title" />

    <RadioGroup
        android:id="@+id/rgWizDuplex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton android:id="@+id/rbWizDuplexOff"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/duplex_off"
            android:textColor="@color/text_primary" android:textSize="13sp" />

        <RadioButton android:id="@+id/rbWizDuplexLong"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/duplex_long"
            android:textColor="@color/text_primary" android:textSize="13sp" />

        <RadioButton android:id="@+id/rbWizDuplexShort"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/duplex_short"
            android:textColor="@color/text_primary" android:textSize="13sp" />
    </RadioGroup>
</merge>
