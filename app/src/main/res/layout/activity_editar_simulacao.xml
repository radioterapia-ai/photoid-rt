<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_sim_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/txtEsSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/edit_sim_subtitle"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <!-- Médico responsável -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/team_medico_label"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <AutoCompleteTextView
            android:id="@+id/actEsMedico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_white"
            android:drawableEnd="@drawable/ic_dropdown_arrow"
            android:padding="12dp"
            android:textColor="#212121"
            android:textSize="14sp" />

        <!-- Equipamento -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/timeout_equip_label"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <AutoCompleteTextView
            android:id="@+id/actEsEquip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_white"
            android:drawableEnd="@drawable/ic_dropdown_arrow"
            android:padding="12dp"
            android:textColor="#212121"
            android:textSize="14sp" />

        <!-- Sítio / Topografia -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sitio_topografia_label"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <AutoCompleteTextView
            android:id="@+id/actEsSitio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_white"
            android:drawableEnd="@drawable/ic_dropdown_arrow"
            android:padding="12dp"
            android:textColor="#212121"
            android:textSize="14sp" />

        <!-- Risco de queda -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/timeout_risco"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <RadioGroup
            android:id="@+id/rgEsRisco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbEsRiscoSim"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/yes" android:textColor="@color/text_primary" android:textSize="12sp" />
            <RadioButton android:id="@+id/rbEsRiscoNao"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:checked="true"
                android:text="@string/timeout_nao" android:textColor="@color/text_primary" android:textSize="12sp" />
        </RadioGroup>

        <!-- Precaução de contato -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/timeout_prec"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <RadioGroup
            android:id="@+id/rgEsPrec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbEsPrecSim"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/yes" android:textColor="@color/text_primary" android:textSize="12sp" />
            <RadioButton android:id="@+id/rbEsPrecNao"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:checked="true"
                android:text="@string/timeout_nao" android:textColor="@color/text_primary" android:textSize="12sp" />
        </RadioGroup>

        <!-- Alergia -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/timeout_alergia"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <RadioGroup
            android:id="@+id/rgEsAlergia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbEsAlergiaSim"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/yes" android:textColor="@color/text_primary" android:textSize="12sp" />
            <RadioButton android:id="@+id/rbEsAlergiaNao"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:checked="true"
                android:text="@string/timeout_nao" android:textColor="@color/text_primary" android:textSize="12sp" />
        </RadioGroup>

        <!-- Observações -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/fin_observation_label"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/edtEsObs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_white"
            android:gravity="top"
            android:hint="@string/fin_observation_hint"
            android:minLines="3"
            android:padding="12dp"
            android:textColor="#212121"
            android:textColorHint="#9E9E9E"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEsSalvar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="@string/edit_sim_save"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_dark"
            android:backgroundTint="@color/action_save"
            android:maxLines="2"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp" />

        <Button
            android:id="@+id/btnEsCancelar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/cancel"
            android:textSize="15sp"
            android:textColor="@color/text_on_dark"
            android:backgroundTint="@color/action_neutral"
            android:maxLines="1" />

        <TextView
            android:id="@+id/txtEsProgresso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:background="@color/status_info"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
