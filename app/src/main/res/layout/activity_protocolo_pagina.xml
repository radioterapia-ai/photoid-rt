<?xml version="1.0" encoding="utf-8"?>
<!--
    Calibração das páginas de UM PDF do protocolo, em RETRATO.

    A página ocupa a maior parte da tela e os controles ficam embaixo: o que se
    confere aqui é se os boxes cobrem algo do documento, e isso só se vê olhando
    a página inteira.

    Em paisagem a Activity usa activity_protocolo_pagina_land, com os controles
    numa coluna ao lado. Os dois layouts incluem os mesmos blocos, então os ids
    são os mesmos nos dois.

    A raiz focável em toque fica com o foco inicial. Sem ela o primeiro campo
    de texto o receberia, e num tablet o teclado abriria sozinho por cima da
    prévia toda vez que a tela abre.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/prot_pagina_ajuda"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:padding="10dp" />

    <include layout="@layout/item_protocolo_pdf_nav" />

    <com.radioterapia.ai.protocolo.ProtocoloPaginaView
        android:id="@+id/viewPagina"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/item_protocolo_pdf_controles" />
    </ScrollView>
</LinearLayout>
