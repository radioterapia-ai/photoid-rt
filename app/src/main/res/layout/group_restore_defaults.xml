<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <Button
        android:id="@+id/btnRedoOnboarding"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="10dp"
        android:text="@string/redo_onboarding"
        android:textColor="@color/text_on_dark"
        android:backgroundTint="@color/brand_primary_dark" />

    <Button
        android:id="@+id/btnRestoreAll"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/restore_all"
        android:textColor="@color/text_on_dark"
        android:backgroundTint="@color/action_discard" />
</LinearLayout>
