<?xml version="1.0" encoding="utf-8"?>
<!--
    Bloco "Protocolo" das Configurações.

    Fica logo depois do PDF porque é dele que trata: as páginas finais da mesma
    ficha. A lista da equipe vem montada em código, uma linha por protocolo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/prot_explica"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/txtProtTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:id="@+id/listaProtocolos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button
        android:id="@+id/btnProtAdicionar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="@string/prot_add"
        android:textColor="@color/text_on_dark"
        android:backgroundTint="@color/brand_primary_dark" />
</LinearLayout>
