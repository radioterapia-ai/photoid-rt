<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- MODO LOTE: barra de ações, visível só durante a seleção múltipla. -->
    <LinearLayout
        android:id="@+id/barraLote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0E1839"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtLoteContagem"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnLoteTodos"
            style="@style/ButtonOutlineCyan"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/lote_todos"
            android:textSize="13sp"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnLoteImprimir"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/lote_imprimir"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_dark"
            android:backgroundTint="@color/action_save" />

        <Button
            android:id="@+id/btnLoteCancelar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/cancel"
            android:textSize="13sp"
            android:textColor="@color/text_on_dark"
            android:backgroundTint="@color/action_neutral" />
    </LinearLayout>

    <!-- Linha única: contagem + Ordenar + busca (metade direita) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/bg_card">

        <TextView
            android:id="@+id/txtHistoricoCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOrdenar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:text="@string/sort_by"
            android:textSize="12sp"
            android:textColor="@color/text_on_dark"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="@color/action_neutral" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Só a lupa: ao tocar, abre a caixa de busca flutuante abaixo -->
        <ImageButton
            android:id="@+id/btnLupa"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_lupa"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="@string/search_patient_hint" />
    </LinearLayout>

    <!-- Caixa de busca FLUTUANTE (aparece só ao tocar na lupa) -->
    <FrameLayout
        android:id="@+id/cardBusca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:background="@color/bg_card"
        android:visibility="gone">

        <EditText
            android:id="@+id/edtBuscaPaciente"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_gravity="end"
            android:hint="@string/search_patient_hint"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:textColor="#212121"
            android:textColorHint="#9E9E9E"
            android:background="@drawable/bg_input_white"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="6dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Cabeçalho de SCAN (só no modo "Pacientes em Tratamento") -->
    <LinearLayout
        android:id="@+id/layoutScanHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnScanEtiqueta"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:text="@string/scan_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_dark"
            android:backgroundTint="@color/brand_primary_dark"
            android:maxLines="2"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeStepGranularity="1sp" />

        <Button
            android:id="@+id/btnScanCodigo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:text="@string/read_barcode"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_dark"
            android:backgroundTint="@color/brand_primary_dark"
            android:maxLines="2"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeStepGranularity="1sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHistorico"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/txtHistoricoEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/empty_history"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
