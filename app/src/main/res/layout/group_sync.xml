<?xml version="1.0" encoding="utf-8"?>
<!--
    SINCRONIZAÇÃO DE PRONTUÁRIOS, nas Configurações.

    A ORDEM AQUI NÃO É DECORATIVA: o interruptor mestre vem primeiro e tudo o
    mais fica esmaecido enquanto ele estiver desligado. Quem abre este bloco
    por curiosidade precisa ver, na primeira linha, que o app não está mandando
    nada para lugar nenhum.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/sync_master"
            android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/text_primary" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swSyncMestre"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" />
    </LinearLayout>

    <TextView style="@style/SectionDesc" android:text="@string/sync_master_hint" />

    <LinearLayout android:id="@+id/blocoSyncDetalhe"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <View style="@style/SeparadorFino" />

        <TextView android:id="@+id/txtSyncOrigem"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/text_secondary"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView style="@style/FieldLabel" android:layout_marginTop="8dp"
            android:text="@string/sync_interval" />
        <EditText android:id="@+id/edtSyncIntervalo" style="@style/InputField"
            android:inputType="number" android:maxLines="1" />

        <CheckBox android:id="@+id/chkSyncGatFoto"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/sync_trigger_photo"
            android:textSize="13sp" android:textColor="@color/text_primary" />
        <CheckBox android:id="@+id/chkSyncGatFim"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/sync_trigger_finish"
            android:textSize="13sp" android:textColor="@color/text_primary" />
        <CheckBox android:id="@+id/chkSyncGatAbrir"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/sync_trigger_open"
            android:textSize="13sp" android:textColor="@color/text_primary" />
        <CheckBox android:id="@+id/chkSyncSoWifi"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/sync_wifi_only"
            android:textSize="13sp" android:textColor="@color/text_primary" />

        <View style="@style/SeparadorFino" />

        <TextView style="@style/SectionHeader" android:text="@string/sync_profiles" />

        <LinearLayout android:id="@+id/listaSyncPerfis"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button android:id="@+id/btnSyncAdicionar" style="@style/ButtonSecondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sync_add_profile" />

        <View style="@style/SeparadorFino" />

        <Button android:id="@+id/btnSyncAgora" style="@style/ButtonPrimary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/sync_now" />

        <TextView android:id="@+id/txtSyncEstado"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:padding="8dp"
            android:textSize="12sp" android:textColor="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
