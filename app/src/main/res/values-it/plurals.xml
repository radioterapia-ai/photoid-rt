<?xml version="1.0" encoding="utf-8"?>
<!--
    Plurais - it

    As CATEGORIAS de quantidade sao por idioma, definidas pelo CLDR, e nao
    acompanham o portugues. Este arquivo usa: one, many, other.

    Categoria de menos faz a frase sair errada numa faixa de numeros; categoria
    de mais vira recurso morto. Conferir no CLDR antes de editar.
-->
<resources>
    <plurals name="patient_count_plural">
        <item quantity="one">1 paziente in anagrafica</item>
        <item quantity="many">%d di pazienti in anagrafica</item>
        <item quantity="other">%d pazienti in anagrafica</item>
    </plurals>
    <plurals name="treatment_count_plural">
        <item quantity="one">1 paziente in trattamento</item>
        <item quantity="many">%d di pazienti in trattamento</item>
        <item quantity="other">%d pazienti in trattamento</item>
    </plurals>
    <plurals name="simulations_count_plural">
        <item quantity="one">1 simulazione</item>
        <item quantity="many">%d di simulazioni</item>
        <item quantity="other">%d simulazioni</item>
    </plurals>
</resources>
