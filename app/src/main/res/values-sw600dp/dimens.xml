<?xml version="1.0" encoding="utf-8"?>
<!--
    Dimensões para TABLET (largura mínima 600dp). Mantém o visual original,
    espaçoso, do Galaxy Tab S6. O celular usa values/dimens.xml (compacto).
-->
<resources>
    <!-- Telas de seleção: Home / Simulação / Tratamento -->
    <dimen name="landing_padding">36dp</dimen>
    <dimen name="brand_title_home">56sp</dimen>
    <dimen name="brand_title_sub">44sp</dimen>
    <dimen name="landing_subtitle">18sp</dimen>
    <dimen name="landing_subtitle_margin">40dp</dimen>
    <dimen name="module_btn_height">110dp</dimen>
    <dimen name="module_btn_text">26sp</dimen>
    <dimen name="module_btn_gap">18dp</dimen>
    <dimen name="secondary_btn_height">78dp</dimen>

    <!-- Câmera -->
    <!-- Altura do aviso "ajuste para encaixar" sobre a base do visor.
         E cam_tab_height + 22dp: ele tem que ficar ACIMA da faixa de
         abas, que passou a flutuar sobre o visor. -->
    <dimen name="aviso_encaixar_base">78dp</dimen>
    <dimen name="cam_tab_height">56dp</dimen>
    <dimen name="cam_action_height">64dp</dimen>
    <!-- O obturador. Tem que CABER na barra: ela mede
         cam_bottom_height + 12dp de padding. -->
    <dimen name="cam_capture_size">72dp</dimen>
    <dimen name="cam_bottom_height">56dp</dimen>
    <dimen name="hist_thumb_size">116dp</dimen>
    <dimen name="hist_nome_text">21sp</dimen>
    <dimen name="hist_sub_text">15sp</dimen>
    <dimen name="hist_sub2_text">14sp</dimen>
</resources>
