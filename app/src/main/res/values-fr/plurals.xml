<?xml version="1.0" encoding="utf-8"?>
<!--
    Plurais - fr

    As CATEGORIAS de quantidade sao por idioma, definidas pelo CLDR, e nao
    acompanham o portugues. Este arquivo usa: one, many, other.

    Categoria de menos faz a frase sair errada numa faixa de numeros; categoria
    de mais vira recurso morto. Conferir no CLDR antes de editar.
-->
<resources>
    <plurals name="patient_count_plural">
        <item quantity="one">%d patient enregistré</item>
        <item quantity="many">%d patients enregistrés</item>
        <item quantity="other">%d patients enregistrés</item>
    </plurals>
    <plurals name="treatment_count_plural">
        <item quantity="one">%d patient en cours de traitement</item>
        <item quantity="many">%d patients en cours de traitement</item>
        <item quantity="other">%d patients en cours de traitement</item>
    </plurals>
    <plurals name="simulations_count_plural">
        <item quantity="one">%d simulation</item>
        <item quantity="many">%d simulations</item>
        <item quantity="other">%d simulations</item>
    </plurals>
</resources>
