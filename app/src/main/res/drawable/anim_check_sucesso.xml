<?xml version="1.0" encoding="utf-8"?>
<!--
    Success check: o traco se desenha, o visto gira de leve e da um pulinho.

    A ORDEM IMPORTA. O traco leva 320 ms; a rotacao e o pulo comecam junto e
    terminam antes, para o movimento parecer consequencia do traco e nao um
    efeito por cima dele. Somados dao ~420 ms — acima disso a confirmacao deixa
    de parecer resposta ao toque e passa a parecer espera.

    A ROTACAO E PEQUENA (-14 graus ate 0). Girar muito transformaria um visto de
    conferencia clinica em enfeite; o suficiente e o que da a sensacao de encaixe.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_check_sucesso">

    <target android:name="traco">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="trimPathEnd"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="320"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="grupoVisto">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="-14"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.72"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.72"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
