<?xml version="1.0" encoding="utf-8"?>
<!--
    O OBTURADOR, pressionado.

    As mesmas quatro camadas, com tres mudancas que juntas leem como AFUNDAR:

      - a sombra encurta de 5dp para 2dp, porque o botao esta mais perto da
        superficie;
      - o corpo desce 2dp (top 6, bottom 7), ocupando o espaco que a sombra
        liberou;
      - o gradiente escurece e o brilho especular cai de 40% para 15%, porque
        uma superficie afundada pega menos luz.

    Nada disso e animacao: e estado de drawable, entao vale mesmo com a escala
    de animacao do sistema em zero — que e a condicao que este projeto exige de
    todo movimento (ver Movimento.ligado()).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:top="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="oval">
            <solid android:color="#40000000" />
        </shape>
    </item>

    <item android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#E8E8E8" />
        </shape>
    </item>

    <item android:top="6dp" android:left="4dp" android:right="4dp" android:bottom="7dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#D64545"
                android:centerColor="#B71C1C"
                android:endColor="#6E0D0D" />
        </shape>
    </item>

    <item android:top="6dp" android:left="4dp" android:right="4dp" android:bottom="7dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="55%p"
                android:centerX="0.5"
                android:centerY="0.22"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

</layer-list>
