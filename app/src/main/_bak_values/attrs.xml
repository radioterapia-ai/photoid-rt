<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Atributos lidos pelo PhotoIdHeaderView (o "PhotoID RT" das telas de
        entrada). São atributos do próprio framework, reaproveitados: o
        tamanho da fonte e o texto do sufixo (RT, RT Sim, RT Check).

        Declarados aqui em vez de montar o int[] à mão no Kotlin porque o
        obtainStyledAttributes(AttributeSet, int[]) exige o array em ordem
        crescente de ID — uma troca de ordem passa na compilação e devolve
        o atributo errado em runtime, sem erro. Com declare-styleable o
        AAPT gera o array ordenado e os índices nomeados.
    -->
    <declare-styleable name="PhotoIdHeaderView">
        <attr name="android:textSize" />
        <attr name="android:text" />
    </declare-styleable>

</resources>
